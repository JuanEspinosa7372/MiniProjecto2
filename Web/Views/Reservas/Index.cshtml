@model List<Reserva>
@{
    ViewData["Title"] = "Reservas";
    bool esPersonal = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Recepcionista);
}

@functions {
    static string ClaseEstado(EstadoReserva estado) => estado switch
    {
        EstadoReserva.Confirmada => "bg-primary",
        EstadoReserva.CheckIn => "bg-success",
        EstadoReserva.CheckOut => "bg-secondary",
        EstadoReserva.Cancelada => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">@(esPersonal ? "Todas las reservas" : "Mis reservas")</h1>
    @if (User.IsInRole(Roles.Huesped))
    {
        <a class="btn btn-primary" asp-action="Nueva">Nueva reserva</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Aún no hay reservas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle tabla-apilada">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    @if (esPersonal) { <th>Huésped</th> }
                    <th>Habitación</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Noches</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td data-label="Reserva">#@r.Id</td>
                        @if (esPersonal) { <td data-label="Huésped">@r.Huesped?.Nombre</td> }
                        <td data-label="Habitación">@r.Habitacion?.Numero (@r.Habitacion?.Tipo)</td>
                        <td data-label="Entrada">@r.FechaEntrada.Fecha()</td>
                        <td data-label="Salida">@r.FechaSalida.Fecha()</td>
                        <td data-label="Noches">@r.Noches</td>
                        <td class="text-end" data-label="Total">@r.Total.Pesos()</td>
                        <td data-label="Estado"><span class="badge @ClaseEstado(r.Estado)">@r.Estado</span></td>
                        <td class="text-end acciones">
                            @if (esPersonal && r.Estado == EstadoReserva.Confirmada)
                            {
                                <form asp-action="CheckIn" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success" disabled="@(r.FechaEntrada.Date > DateTime.Today)" title="@(r.FechaEntrada.Date > DateTime.Today ? "Disponible desde la fecha de entrada" : "")">Check-in</button>
                                </form>
                            }
                            @if (esPersonal && r.Estado == EstadoReserva.CheckIn)
                            {
                                <form asp-action="CheckOut" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-secondary">Check-out</button>
                                </form>
                            }
                            @if (r.Estado == EstadoReserva.Pendiente || r.Estado == EstadoReserva.Confirmada)
                            {
                                <form asp-action="Cancelar" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Cancelar la reserva #@r.Id?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
