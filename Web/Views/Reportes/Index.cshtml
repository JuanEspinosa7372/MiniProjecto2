@model ReporteVM
@{
    ViewData["Title"] = "Reportes";
}

<h2 class="mb-3">Reportes</h2>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card text-bg-primary"><div class="card-body">
            <div class="small">Ingresos (reservas no canceladas)</div>
            <div class="fs-3 fw-bold">@Model.IngresoTotal.Pesos()</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <h5>Ingresos por mes</h5>
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Mes</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @foreach (var par in Model.IngresosPorMes)
                    {
                        <tr><td>@par.Key</td><td class="text-end">@par.Value.Pesos()</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h5>Reservas por estado</h5>
        <table class="table table-sm table-striped">
            <thead><tr><th>Estado</th><th class="text-end">Cantidad</th></tr></thead>
            <tbody>
                @foreach (var par in Model.ReservasPorEstado)
                {
                    <tr><td>@par.Key</td><td class="text-end">@par.Value</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <h5>Reservas por tipo de habitación</h5>
        <table class="table table-sm table-striped">
            <thead><tr><th>Tipo</th><th class="text-end">Cantidad</th></tr></thead>
            <tbody>
                @foreach (var par in Model.ReservasPorTipo)
                {
                    <tr><td>@par.Key</td><td class="text-end">@par.Value</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<hr class="my-4" />

<h4>Estructuras de datos: comparación de tiempos</h4>
<p class="text-muted">
    Se ejecutan 5.000 búsquedas sobre 20.000 elementos. Esta comparación justifica el uso de
    <code>Dictionary</code> y <code>HashSet</code> frente a <code>List</code> para búsquedas.
</p>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr><th>Prueba</th><th>Estructura</th><th>Complejidad</th><th class="text-end">Tiempo (ms)</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Comparaciones)
            {
                <tr>
                    <td>@c.Prueba</td>
                    <td>@c.Estructura</td>
                    <td>@c.Complejidad</td>
                    <td class="text-end">@c.Milisegundos.ToString("N3")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<ul>
    <li><strong>List&lt;T&gt;</strong>: resultados de consultas y listados ordenados con LINQ.</li>
    <li><strong>Dictionary&lt;K,V&gt;</strong>: acceso directo por llave (totales por habitación, agrupaciones de reportes).</li>
    <li><strong>HashSet&lt;T&gt;</strong>: saber si una habitación está ocupada sin recorrer toda la colección.</li>
    <li><strong>SortedDictionary&lt;K,V&gt;</strong>: ingresos por mes siempre ordenados cronológicamente.</li>
</ul>
