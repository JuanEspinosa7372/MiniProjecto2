@model List<Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
    @{ var ocupadas = (HashSet<int>)ViewBag.Ocupadas; }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Habitaciones</h2>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Número</th>
                <th>Tipo</th>
                <th>Capacidad</th>
                <th class="text-end">Precio por noche</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.Numero</td>
                    <td>@h.Tipo</td>
                    <td>@h.Capacidad</td>
                    <td class="text-end">@h.PrecioNoche.Pesos()</td>
                    <td>
                    {
                        <span class="badge bg-warning text-dark">Mantenimiento</span>
                    }
                    else if (ocupadas.Contains(h.Id))
                    {
                        <span class="badge bg-danger">Ocupada</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@h.Id">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
