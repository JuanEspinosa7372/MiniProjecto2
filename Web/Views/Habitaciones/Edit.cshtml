@model Habitacion
@{
    ViewData["Title"] = "Editar habitación";
}

<h2 class="mb-3">Editar habitación @Model.Numero</h2>

<form asp-action="Edit" method="post" class="panel">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
