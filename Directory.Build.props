<Project>
  <!--
    AJUSTA ESTAS DOS LÍNEAS SEGÚN TU SDK (comando: dotnet --version)
      SDK 8.x  -> net8.0  y 8.0.*
      SDK 9.x  -> net9.0  y 9.0.*
      SDK 10.x -> net10.0 y 10.0.*
  -->
  <PropertyGroup>
    <HotelTfm>net8.0</HotelTfm>
    <EfVersion>8.0.*</EfVersion>
  </PropertyGroup>
</Project>
